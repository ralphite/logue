{
  "manifest_version": 3,
  "name": "Logue",
  "description": "在任意网页输入、采集选区并沉淀为本机资料。",
  "version": "0.2.0",
  "permissions": ["activeTab", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "action": {
    "default_title": "打开 Logue"
  },
  "commands": {
    "start-voice-input": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "在当前聚焦的输入框开始 Logue 语音输入"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
