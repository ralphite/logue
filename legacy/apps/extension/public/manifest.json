{
  "manifest_version": 3,
  "name": "Logue",
  "description": "Capture voice, selections, and page context without leaving your work.",
  "version": "0.2.13",
  "version_name": "v0.2.13",
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage", "unlimitedStorage", "offscreen", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Open Logue"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "start-voice-write": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Start Logue Voice Write in the current input"
    },
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open or close Logue"
    },
    "start-voice-command": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Start a Logue voice command"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
