node_modules/
dist/
storybook-static/
coverage/
.DS_Store
*.log
.env
.env.*
!.env.example

# Local data and captures never belong in the repo.
# Bug screenshots live beside the task that cites them, but stay out of git.
docs/spec/shots/
# What a browser check saw. Written next to the check that took it, never
# committed: it is evidence from one run, not part of the product.
scripts/qa/*.png
.logue-data/
# Every workspace copy, not just the live one. A rebuild left a backup beside
# it as `.logue-data.before-rebuild-<n>/`, which this pattern did not match —
# so 455 files of someone's recordings, and the API key sitting among them,
# went into a public repository and the key was revoked as leaked.
.logue-data*/
.logue-backups/
.artifacts/
artifacts/
release/
__pycache__/
*.pyc
*.tsbuildinfo
scripts/qa/spoken-loop.wav

# Phoenix, for tracing while debugging. A venv beside the repo rather than in
# the Host's own interpreter: the Host has no third-party packages and this
# does not give it one.
.phoenix-venv/
